# Root .env — used by `docker compose up` to fill in ${VARIABLE} placeholders
# in docker-compose.yml. Copy this to .env and fill in real values.

# From the Clerk dashboard: Configure > API Keys > Show API URLs
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json

# From the Clerk dashboard: Configure > API Keys > Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx